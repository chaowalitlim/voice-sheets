# Anthropic API key used to parse speech into rows (https://platform.claude.com)
ANTHROPIC_API_KEY=sk-ant-...

# OAuth 2.0 Web client ID from Google Cloud Console (see README)
GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# Optional: only these Google accounts may use the app (comma-separated)
ALLOWED_EMAILS=

# Optional
PORT=3000
CLAUDE_MODEL=claude-opus-5-5
RATE_LIMIT_PER_MIN=20
